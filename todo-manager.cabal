cabal-version:      3.0
name:               todo-manager
version:            0.1.0.0
-- synopsis:
-- description:
license:            BSD-3-Clause
license-file:       LICENSE
author:             Bardh Ahmeti
maintainer:         bardh534@gmail.com
-- copyright:
build-type:         Simple
extra-doc-files:    CHANGELOG.md
-- extra-source-files:

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:  Types TaskOperations Filters Reports Persistence Validation JsonExport DSL
    -- other-modules:
    build-depends:    base >=4.18.3.0, directory, aeson, bytestring, text

    hs-source-dirs:   src
    default-language: Haskell2010

executable todo-manager
    import:           warnings
    main-is:          Main.hs
    -- other-modules:
    -- other-extensions:
    build-depends:
        base ^>=4.18.3.0,
        todo-manager,
        directory,     
        aeson,
        bytestring,
        text

    hs-source-dirs:   app
    default-language: Haskell2010
